{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC output contract",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "storyId",
      "userStory",
      "criteria",
      "source",
      "gap",
      "reviewStatus"
    ],
    "additionalProperties": false,
    "properties": {
      "storyId": {
        "type": "string",
        "pattern": "^US-[0-9]{2}$"
      },
      "userStory": {
        "type": "string",
        "minLength": 1
      },
      "criteria": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^Given .+ When .+ Then .+"
        }
      },
      "source": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^BRD.md#RP-00[1-4]$"
        }
      },
      "gap": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reviewStatus": {
        "enum": [
          "Draft",
          "Needs Clarification",
          "Ready for Review",
          "Approved"
        ]
      }
    }
  }
}
